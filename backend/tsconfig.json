{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "bun"
    ],
    "paths": {
      "shared": [
        "../shared/src/index.ts"
      ]
    },
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/embedded/assets.gen.ts"
  ]
}