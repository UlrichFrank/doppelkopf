# Doppelkopf: game server, NPCs and embedded game page as a single binary.
# Installed to /etc/systemd/system/doppelkopf.service by `make deploy`.
# Traefik (Docker stack ~/deploy/traefik) routes to it via the file provider,
# see traefik-doppelkopf.yml.

[Unit]
Description=Doppelkopf (Spielserver, Computergegner und Spielseite)
Documentation=https://github.com/UlrichFrank/doppelkopf/blob/main/deploy/README.md
# The bind address is the gateway of the Docker network "web", which only
# exists once Docker is up
Wants=network-online.target docker.service
After=network-online.target docker.service
# Keep retrying until the address exists (e.g. right after boot)
StartLimitIntervalSec=0

[Service]
Type=simple
User=doppelkopf
Group=doppelkopf
ExecStart=/opt/doppelkopf/doppelkopf
WorkingDirectory=/var/lib/doppelkopf
StateDirectory=doppelkopf
Environment=NODE_ENV=production
# Only reachable for Traefik (Docker network "web"), not from the internet.
# Port 3001 on this address belongs to Ausgebremst, 3002 to Molthar.
Environment=HOST=172.18.0.1
Environment=PORT=3003
Environment=MATCHES_FILE=/var/lib/doppelkopf/matches.json
# NPC seat credentials — without them running NPC matches hang after a restart
Environment=NPC_DATA_DIR=/var/lib/doppelkopf
# Socket.IO checks the Origin header even for same-origin pages
Environment=EXTRA_ORIGINS=https://doppelkopf.apps.diefranks.eu
Restart=always
RestartSec=2
# Matches are written on SIGTERM; give it a moment before SIGKILL
TimeoutStopSec=10
MemoryMax=400M

# Hardening (Bun's JIT needs writable+executable memory: no MemoryDenyWriteExecute)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
